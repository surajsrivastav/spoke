FROM node:22.23.2-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=docker:29.1.2-cli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
RUN npm install -g pnpm@10.33.0

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.json ./
COPY apps/operator-ui/package.json apps/operator-ui/
COPY apps/slack-edge/package.json apps/slack-edge/
COPY apps/orchestrator/package.json apps/orchestrator/
COPY apps/whatsapp-edge/package.json apps/whatsapp-edge/
COPY packages/ packages/

RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm rebuild
RUN pnpm --filter @spoke/db generate
