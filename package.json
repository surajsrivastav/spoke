{
  "name": "spoke",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=22.23.2 <23", "pnpm": "10.33.0" },
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @spoke/operator-ui --filter @spoke/orchestrator --parallel dev",
    "dev:slack": "pnpm --filter @spoke/slack-edge dev",
    "dev:whatsapp": "pnpm --filter @spoke/whatsapp-edge dev",
    "test": "pnpm -r test",
    "test:mutation": "pnpm -r test:mutation",
    "ralph": "tsx scripts/ralph.ts",
    "edge-cases": "tsx scripts/edge-case-finder.ts",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @spoke/db exec node --env-file=../../.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:studio": "pnpm --filter @spoke/db studio"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.6.5": "^7.6.5",
      "form-data@^4": "^4.0.6",
      "fast-uri@^3": "^3.1.6",
      "postcss@^8": "^8.5.18",
      "nanoid@^3": "^3.3.18",
      "browserslist@^4": "^4.28.7",
      "axios@^1": "^1.18.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@swc/core",
      "protobufjs"
    ]
  }
}
