# Database
DATABASE_URL=postgresql://spoke:spoke_dev@localhost:5432/spoke_dev

# Model provider (openrouter | anthropic | litellm | copilot | github-models | ollama)
MODEL_PROVIDER=ollama
DEFAULT_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_BASE_URL=
COPILOT_TOKEN=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=

# GitHub (set this for PR creation)
GH_TOKEN=

# Slack (set these for Slack integration)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# WhatsApp (set these for WhatsApp integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=spoke_verify_token

# App ports
OPERATOR_UI_PORT=3000
SLACK_EDGE_PORT=3001
WHATSAPP_EDGE_PORT=3002

# Cost governance (F-07)
DEFAULT_COST_CAP_USD=5.00
# Optional: team whose budget is checked for Slack-submitted tasks
SPOKE_TEAM_ID=

# Local beta only. SSO/RBAC does not yet protect every route; see SECURITY.md.
# Keep the API private even when AUTH_ENABLED=true.
AUTH_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
# Optional overrides when the provider does not follow <issuer>/{authorize,token,userinfo}
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_PROVIDER=google
# Comma-separated email domains allowed to sign in (empty = allow all)
SSO_ALLOWED_DOMAINS=
SSO_DEFAULT_ROLE=operator
SESSION_TTL_HOURS=8
